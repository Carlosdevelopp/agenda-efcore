@model Agenda.EFCore.Models.ViewModels.ForgotPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <title>Forgot Password</title>
</head>
<body class="bg-white">
    <main class="container">
        <div class="row justify-content-center align-items-center vh-100">
            <div class="col-12 col-md-5 col-lg-4">

                <div class="mb-5">
                    <h1 class="display-6 fw-bolder text-dark mb-2">Recuperar acceso</h1>
                    <p class="text-secondary">Escribe tu correo y te ayudaremos a volver.</p>
                </div>

                <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="needs-validation">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-light text-danger small border-0 ps-0"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-bold small text-dark">CORREO ELECTRÓNICO</label>
                        <input asp-for="Email" class="form-control form-control-lg border-0 bg-light px-4 py-3"
                               placeholder="nombre@ejemplo.com"
                               style="border-radius: 12px; font-size: 0.95rem;" />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-dark btn-lg py-3 fw-bold"
                                style="border-radius: 12px; letter-spacing: 0.5px;">
                            Enviar instrucciones
                        </button>
                    </div>

                    <div class="text-center">
                        <a asp-action="Login" class="text-muted text-decoration-none small fw-medium hover-dark">
                            ¿Recordaste tu contraseña? <span class="text-primary">Inicia sesión</span>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <style>
        /* Efecto sutil al pasar el mouse por el input */
        .form-control:focus {
            background-color: #f8f9fa !important;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1) !important;
            border: none !important;
        }

        .hover-dark:hover {
            color: #212529 !important;
        }

        </small >
        </body >
</html>
