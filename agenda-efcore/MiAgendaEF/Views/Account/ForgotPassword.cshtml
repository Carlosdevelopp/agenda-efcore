@model Agenda.EFCore.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Recuperar contraseña";
}

<!DOCTYPE html>
<html>
<head>
    <title>Forgot Password</title>
</head>
<body>
    <main class="form-signin w-100 m-auto">
        <form asp-controller="Account" asp-action="ForgotPassword" method="post">

            @Html.AntiForgeryToken()

            <h1 class="h4 mb-3 fw-normal text-center">¿Olvidaste tu contraseña?</h1>
            
            <p class="text-muted text-center mb-4">
                Ingresa tu correo electrónico y te enviaremos instrucciones para restablecer tu contraseña.
            </p>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" />
                <label asp-for="Email"></label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-primary">
                Enviar instrucciones
            </button>

            <div class="text-center mt-3">
                <a asp-action="Login" class="link-primary text-decoration-none">
                    Volver al inicio de sesión
                </a>
            </div>
        </form>
    </main>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>
