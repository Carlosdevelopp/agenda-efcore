@using Agenda.EFCore.Models.ViewModels
@model ResetPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <title>Recuperar contraseña</title>
</head>
<body class="bg-light">
    <div class="container-fluid">
        <div class="row min-vh-100">
            <div class="col-md-6 d-none d-md-flex bg-primary align-items-center justify-content-center text-white"
                 style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="p-5 text-center">
                    <i class="bi bi-shield-check" style="font-size: 5rem;"></i>
                    <h1 class="display-4 fw-bold mt-3">Seguridad</h1>
                    <p class="lead">Estás a un paso de recuperar el acceso a tu cuenta.</p>
                </div>
            </div>

            <div class="col-md-6 d-flex align-items-center bg-white">
                <div class="container p-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="mb-5 text-center text-md-start">
                                <h2 class="fw-bold text-dark">Restablecer contraseña</h2>
                                <p class="text-muted">Por favor, introduce tu nueva clave de acceso.</p>
                            </div>

                            <form asp-action="ResetPassword" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="Token" />

                                <div asp-validation-summary="ModelOnly" class="alert alert-light text-danger border-0 p-0 small mb-3"></div>

                                <div class="form-group mb-4">
                                    <label asp-for="NewPassword" class="form-label fw-semibold small text-uppercase">Nueva Contraseña</label>
                                    <div class="input-group input-group-merge border-bottom">
                                        <span class="input-group-text bg-transparent border-0 ps-0">
                                            <i class="bi bi-lock text-muted"></i>
                                        </span>
                                        <input asp-for="NewPassword" type="password" class="form-control border-0 shadow-none" placeholder="••••••••" />
                                    </div>
                                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                                </div>

                                <div class="form-group mb-4">
                                    <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-uppercase">Confirmar Contraseña</label>
                                    <div class="input-group input-group-merge border-bottom">
                                        <span class="input-group-text bg-transparent border-0 ps-0">
                                            <i class="bi bi-shield-lock text-muted"></i>
                                        </span>
                                        <input asp-for="ConfirmPassword" type="password" class="form-control border-0 shadow-none" placeholder="••••••••" />
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>

                                <div class="d-grid gap-3 mt-5">
                                    <button type="submit" class="btn btn-dark btn-lg rounded-pill shadow-sm py-3 fw-bold">
                                        Actualizar Contraseña
                                    </button>
                                    <a asp-action="Login" class="btn btn-outline-secondary btn-sm border-0">
                                        Regresar al inicio de sesión
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>


