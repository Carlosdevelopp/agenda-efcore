@using MiAgendaEF.Models.ViewModels
@model ContactoViewModel;
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Editar Contacto</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="container py-5">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-md-7 col-lg-5">

                <div class="auth-card-pro">
                    <div class="text-center mb-5">
                        <div class="mb-3">
                            <i class="bi bi-person-circle text-info" style="font-size: 3rem;"></i>
                        </div>
                        <h2 class="fw-bold text-white mb-1">Registro</h2>
                        <p class="text-muted small">Crea un nuevo perfil administrativo</p>
                    </div>

                    <form asp-controller="Contacts" asp-action="Update" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="ContactoId"/>
                        <input type="hidden" asp-for="UsuarioId"/>
                        <input type="hidden" asp-for="FotoRuta" />

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-4 text-center"></div>

                        @if (!string.IsNullOrEmpty(Model.FotoRuta))
                        {
                            <div class="text-center mb-3">
                                <img src="@Model.FotoRuta" alt="Foto actual" class="foto-preview"
                                style="width: 150px; height: 150px; border-radius: 50%; -o-object-fit: cover;"/>
                                <p class="text-muted smalll">Foto actual</p>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="FotoPerfil" class="form-label">Cambiar Foto(opcional)</label>
                            <input asp-for="FotoPerfil" type="file" class="form-control" accept="image/*" id="foto"/>
                            <span asp-validation-for="FotoPerfil" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NombreCompleto" class="label-pro">Nombre Completo</label>
                            <input asp-for="NombreCompleto" class="input-field-pro w-100" placeholder="Escribe tu nombre">
                            <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FechaNacimiento" class="label-pro">Fecha de Nacimiento</label>
                            <input asp-for="FechaNacimiento" type="date" class="input-field-pro w-100" style="color-scheme: dark;">
                            <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Instagram" class="form-label">Instagram</label>
                            <input asp-for="Instagram" class="form-control" placeholder="URL"/>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Facebook" class="form-label">Facebook</label>
                            <input asp-for="Facebook" class="form-control" placeholder="URL" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Twitter" class="form-label">Twitter</label>
                            <input asp-for="Twitter" class="form-control" placeholder="URL" />
                        </div>

                        <div class="d-grid mt-5">
                            <button type="submit" class="btn-search-neon py-3 fw-bold">CONFIRMAR REGISTRO</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        </div>

                        <div class="text-center mt-4">
                            <a asp-action="Login" class="text-muted small text-decoration-none">
                                ¿Ya tienes cuenta? <span class="text-info fw-bold">Inicia Sesión</span>
                            </a>
                        </div>
                    </form>

                    @section Scripts {
                        @{
                            await Html.RenderPartialAsync("_ValidationScriptsPartial");
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</body>
</html>