@using MiAgendaEF.Models.ViewModels
@model AgendaViewModel

@{
    Layout = null;
    ViewData["Title"] = "Mis Contactos";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Contactos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
</head>
<body>
    <div class="container mt-4">
        <div class="row align-items-start mb-5">
            <div class="col-md-8">
                <div class="mb-4">
                    <h1 class="display-6 mb-3">Gestión de Contactos</h1>
                    <a asp-controller="Contacts" asp-action="Create" method="post" class="btn btn-success shadow-sm">
                        <i class="bi bi-plus-circle"></i> Crear nuevo contacto
                    </a>
                </div>

                <p class="text-muted fs-5">
                    Tienes <span class="badge bg-primary rounded-pill">@Model.TotalContactos</span> contactos almacenados
                </p>

                <div class="row mt-4">
                    <div class="col-lg-10">
                        <form asp-action="Index" method="get" class="input-group shadow-sm">
                            <input type="text" asp-for="TerminoBusqueda" class="form-control" placeholder="Buscar por nombre, teléfono..." aria-label="Search">
                            <button class="btn btn-success" type="submit">Buscar</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-4 d-flex flex-column align-items-end mt-5">
                <a asp-controller="Account" asp-action="Login"
                   class="btn btn-sm btn-outline-danger border-0 p-0 mb-1"
                   title="Cerrar Sesión" style="font-size: 1.5rem; line-height: 1;">
                    &times;
                </a>
                <img src="~/images/tu-foto.jpg"
                     alt="Perfil"
                     class="rounded-circle border shadow-sm"
                     style="width: 100px; height: 100px; object-fit: cover;">
                <span class="fw-bold fs-3 mt-2 text-dark">Agenda TI</span>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <h2 class="h4 mb-3 border-bottom pb-2 text-secondary">Lista de Contactos</h2>

                @if (Model.Contactos != null && Model.Contactos.Any())
                {
                    @foreach (var contacto in Model.Contactos)
                    {
                        <div class="card mb-3 shadow-sm border-0 bg-light">
                            <div class="card-body d-flex align-items-center">

                                <div class="me-4 text-center border-end pe-4" style="min-width: 150px;">
                                    @* <img src="@contacto.ImagenUrl" class="rounded-circle mb-2 border" style="width: 70px; height: 70px; object-fit: cover;"> *@
                                    <h5 class="card-title mb-0 text-dark">@contacto.NombreCompleto</h5>
                                </div>

                                <div class="flex-grow-1 ps-2">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <p class="mb-1"><i class="bi bi-person text-muted me-2"></i><strong>Edad:</strong> @contacto.Edad años</p>
                                            <p class="mb-1"><i class="bi bi-telephone text-muted me-2"></i><strong>Teléfono:</strong> @contacto.Telefono</p>
                                        </div>
                                        <div class="col-md-6">
                                            @foreach (var red in contacto.RedesSociales)
                                            {
                                                <p class="mb-0 small">
                                                    <span class="text-primary fw-bold text-uppercase">Red Social:</span><br>
                                                    <a href="@red.URL" class="text-break" target="_blank">@red.URL</a>
                                                </p>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="ms-auto text-end d-flex flex-column justify-content-between align-items-end" style="min-height: 100px;">
                                    @if (contacto.Edad == 30)
                                    {
                                        <img src="~/images/birthday-cake.png" alt="Cumple" width="30" class="mb-2" title="¡Es su cumpleaños!">
                                    }

                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Editar" asp-route-id="@contacto.ContactoId" class="btn btn-outline-secondary">Editar</a>
                                        <a asp-action="EditarRedes" asp-route-id="@contacto.ContactoId" class="btn btn-outline-primary">Redes</a>
                                        <a asp-action="Eliminar" asp-route-id="@contacto.ContactoId" class="btn btn-danger">Eliminar</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info shadow-sm border-0 d-flex align-items-center">
                        <i class="bi bi-info-circle-fill me-2 fs-4"></i>
                        No se encontraron contactos para mostrar. ¡Es hora de agregar uno!
                    </div>
                }
            </div>
        </div>

        <div class="row mt-5 mb-5">
            <div class="col-12 d-grid">
                <button type="button" class="btn btn-dark btn-lg shadow">Salir del Sistema</button>
            </div>
        </div>
    </div>
</body>
</html>