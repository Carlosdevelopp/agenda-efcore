@using MiAgendaEF.Models.ViewModels
@model AgendaViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contactos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body>
    <form asp-controller="Account" asp-action="Logout" method="post">
        <nav class="glass-nav mb-5">
            <div class="container d-flex justify-content-between align-items-center">
                <div class="stats-pill shadow-sm">
                    <i class="bi bi-person-check-fill me-2"></i>
                    <span>@Model.TotalContactos REGISTROS</span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="text-end d-none d-md-block" style="line-height: 1.1;">
                        <span class="text-muted small d-block">Bienvenido,</span>
                        <span class="fw-bold text-white small">Administrador TI</span>
                    </div>
                    <img src="~/images/tu-foto.jpg" alt="User" class="user-avatar-frame shadow-lg">

                    <button type="submit" class="btn-logout-pro" style="border: none; background: none;">
                        <i class="bi bi-box-arrow-right me-1"></i> SALIR
                    </button>
                </div>
            </div>
        </nav>
    </form>

    <div class="container">
        <div class="row g-4 mb-5">
            <div class="col-lg-3">
                <a asp-action="Create" class="btn btn-outline-info w-100 h-100 rounded-pill fw-bold border-2 d-flex align-items-center justify-content-center">
                    <i class="bi bi-plus-lg me-2"></i> AGREGAR
                </a>
            </div>

            <div class="col-lg-9">
                <form asp-action="Index" method="get" class="search-glass-dark">
                    <i class="bi bi-search text-info me-3"></i>
                    <input type="text" asp-for="TerminoBusqueda" placeholder="Filtrar por nombre o teléfono..." class="border-0 bg-transparent text-white w-100" style="outline: none;">
                    <button type="submit" class="btn-search-neon">BUSCAR</button>
                </form>
            </div>
        </div>

        <div class="row g-4">
            @if (Model.Contactos != null && Model.Contactos.Any())
            {
                @foreach (var contacto in Model.Contactos)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card bg-transparent border border-white border-opacity-10 rounded-4 p-4 h-100 @(contacto.Edad == 30 ? "card-birthday-active" : "")"
                             style="background: rgba(255,255,255,0.03); backdrop-filter: blur(10px);">

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="bg-info bg-opacity-20 text-info fw-bold rounded-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; border: 1px solid rgba(0,210,255,0.3);">
                                    @contacto.NombreCompleto.Substring(0, 1)
                                </div>

                                @if (contacto.Edad == 30)
                                {
                                    <span class="badge rounded-pill" style="background: var(--accent-gold); color: #000; font-weight: 800; font-size: 0.65rem; padding: 6px 12px;">
                                        <i class="bi bi-gift-fill me-1"></i> ¡CUMPLEAÑOS!
                                    </span>
                                }
                            </div>

                            <p class="text-muted small mb-4">ID Registro: #@contacto.ContactoId</p>

                            <div class="p-3 rounded-3 mb-4" style="background: rgba(0,0,0,0.3);">
                                <!-- Foto del contacto -->
                                <div class="text-center mb-3">
                                    @if (!string.IsNullOrEmpty(contacto.FotoRuta))
                                    {
                                        <img src="@contacto.FotoRuta"
                                             alt="Foto de @contacto.NombreCompleto"
                                             class="rounded-circle"
                                             style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #0dcaf0;" />
                                    }
                                    else
                                    {
                                        <img src="~/images/default.png"
                                             alt="Sin foto"
                                             class="rounded-circle"
                                             style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #666;" />
                                    }
                                </div>

                                <h5 class="fw-bold text-white mb-3 text-center">@contacto.NombreCompleto</h5>

                                <div class="d-flex justify-content-between mb-2 small">
                                    <span class="text-muted">Móvil</span>
                                    <span class="fw-bold text-white">@contacto.Telefono</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2 small">
                                    <span class="text-muted">Edad</span>
                                    <span class="fw-bold text-white">@contacto.Edad Años</span>
                                </div>

                                @if (contacto.RedesSociales != null && contacto.RedesSociales.Any())
                                {
                                    <div class="mt-3 pt-3 border-top border-secondary">
                                        <p class="text-muted small mb-2 text-center">Redes Sociales:</p>
                                        <div class="d-flex gap-2 justify-content-center">
                                            @foreach (var item in contacto.RedesSociales)
                                            {
                                                @if (item.TipoContactoId == 1) 
                                                {
                                                    <a href="@item.URL" target="_blank" class="text-decoration-none" title="Instagram">
                                                        <i class="fab fa-instagram" style="font-size: 40px; color: #E4405F"></i>
                                                    </a>
                                                }
                                                else if (item.TipoContactoId == 2) 
                                                {
                                                    <a href="@item.URL" target="_blank" class="text-decoration-none" title="Facebook">
                                                        <i class="fab fa-facebook" style="font-size: 24px; color: #1877f2;"></i>
                                                    </a>
                                                }
                                                else if (item.TipoContactoId == 3)
                                                {
                                                    <a href="@item.URL" target="_blank" class="text-decoration-none" title="Twitter">
                                                        <i class="fab fa-twitter" style="font-size: 24px; color: #1DA1F2;"></i>
                                                    </a>
                                                }
                                            }
                                        </div>
                                    </div>
                                }

                                <!-- Botones de acción -->
                                <div class="mt-3 d-flex gap-2">
                                    <a asp-action="Update" asp-route-contactoId="@contacto.ContactoId"
                                       class="btn btn-sm btn-outline-info flex-grow-1">
                                        <i class="fas fa-edit"></i> Editar
                                    </a>
                                    <form asp-action="Delete" asp-route-contactoId="@contacto.ContactoId"
                                          method="post" class="flex-grow-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100"
                                                onclick="return confirm('¿Estás seguro de eliminar este contacto?')">
                                            <i class="fas fa-trash"></i> Eliminar
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-info text-center">
                        <i class="bi bi-info-circle me-2"></i>
                        No hay contactos registrados. <a asp-action="Create" class="alert-link">Agregar el primero</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>