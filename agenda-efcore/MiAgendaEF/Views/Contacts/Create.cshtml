@using MiAgendaEF.Models.ViewModels
@model CreateContactViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Formulario crear nuevo contacto</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="container py-5">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-md-7 col-lg-5">

                <div class="auth-card-pro">
                    <div class="text-center mb-4">

                        <!-- Preview de la foto -->
                        <div id="fotoPreviewContainer" class="foto-placeholder">
                            <i class="bi bi-person-circle" style="font-size: 3rem; color: rgba(255,255,255,0.3);"></i>
                        </div>
                        
                        <h2 class="fw-bold text-white mb-1">Registro</h2>
                        <p class="text-muted small">Crea un nuevo perfil administrativo</p>
                    </div>

                    <form asp-controller="Contacts" asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-4 text-center"></div>

                        <!-- Campo para cargar foto -->
                        <div class="mb-3">
                            <label asp-for="FotoRuta" class="label-pro">
                                <i class="fas fa-camera me-2"></i>Foto de Perfil
                            </label>
                            <input type="file" class="input-field-pro w-100" id="foto" name="FotoRuta" accept="image/*">
                            <small class="text-muted" style="font-size: 0.75rem;">Formatos: JPG, PNG, GIF</small>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Nombre" class="label-pro">Nombre</label>
                            <input asp-for="Nombre" class="input-field-pro w-100" placeholder="Escribe tu nombre">
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <label asp-for="PrimerApellido" class="label-pro">1er Apellido</label>
                                <input asp-for="PrimerApellido" class="input-field-pro w-100" placeholder="Paterno">
                                <span asp-validation-for="PrimerApellido" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="SegundoApellido" class="label-pro">2do Apellido</label>
                                <input asp-for="SegundoApellido" class="input-field-pro w-100" placeholder="Materno">
                                <span asp-validation-for="SegundoApellido" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="FechaNacimiento" class="label-pro">Fecha de Nacimiento</label>
                            <input asp-for="FechaNacimiento" type="date" class="input-field-pro w-100" style="color-scheme: dark;">
                            <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                        </div>

                        <!-- Campo de Teléfono -->
                        <div class="mb-4">
                            <label for="Telefono" class="label-pro">
                                <i class="fas fa-phone me-2"></i>Teléfono
                            </label>
                            <input type="tel" id="Telefono" name="Telefono" class="input-field-pro w-100" placeholder="Ej: 5512345678" pattern="[0-9]{10}" maxlength="10">
                            <small class="text-muted" style="font-size: 0.75rem;">10 dígitos sin espacios</small>
                        </div>

                        <!-- Sección de Redes Sociales -->
                        <div class="mb-4">
                            <label class="label-pro mb-3">
                                <i class="fas fa-share-alt me-2"></i>Redes Sociales (Opcional)
                            </label>

                            <!-- Iconos de redes sociales -->
                            <div class="social-icons">
                                <div class="social-icon instagram" onclick="toggleSocialInput('instagram')" id="icon-instagram" title="Instagram">
                                    <i class="fab fa-instagram"></i>
                                </div>
                                <div class="social-icon facebook" onclick="toggleSocialInput('facebook')" id="icon-facebook" title="Facebook">
                                    <i class="fab fa-facebook-f"></i>
                                </div>
                                <div class="social-icon twitter" onclick="toggleSocialInput('twitter')" id="icon-twitter" title="Twitter">
                                    <i class="fab fa-twitter"></i>
                                </div>
                            </div>

                            <!-- Input para Instagram -->
                            <div id="input-instagram" class="social-input-container">
                                <div class="social-label label-pro">
                                    <i class="bi bi-instagram" style="color: #e1306c;"></i>
                                    <span>Usuario de Instagram</span>
                                </div>
                                <input type="text" name="Instagram" id="Instagram" class="input-field-pro w-100" placeholder="URL completa">
                                <small class="text-muted" style="font-size: 0.75rem;">Ej:https://instagram.com/miusuario</small>
                            </div>

                            <!-- Input para Facebook -->
                            <div id="input-facebook" class="social-input-container">
                                <div class="social-label label-pro">
                                    <i class="fab fa-facebook-f" style="color: #1877f2;"></i>
                                    <span>Perfil de Facebook</span>
                                </div>
                                <input type="text" name="Facebook" id="Facebook" class="input-field-pro w-100" placeholder="URL de tu perfil">
                                <small class="text-muted" style="font-size: 0.75rem;">Ej: https://facebook.com/miperfil</small>
                            </div>

                            <!-- Input para Twitter -->
                            <div id="input-twitter" class="social-input-container">
                                <div class="social-label label-pro">
                                    <i class="fab fa-twitter" style="color: #1da1f2;"></i>
                                    <span>Usuario de Twitter</span>
                                </div>
                                <input type="text" name="Twitter" id="Twitter" class="input-field-pro w-100" placeholder="URL completa">
                                <small class="text-muted" style="font-size: 0.75rem;">Ej: o https://twitter.com/miusuario</small>
                            </div>
                        </div>

                        <div class="d-grid mt-5">
                            <button type="submit" class="btn-search-neon py-3 fw-bold">
                                CONFIRMAR REGISTRO
                            </button>
                        </div>

                        <div class="text-center mt-4">
                            <a asp-action="Login" class="text-muted small text-decoration-none">
                                ¿Ya tienes cuenta? <span class="text-info fw-bold">Inicia Sesión</span>
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
         // Event listeners modernos (sin deprecated warnings)
        document.addEventListener('DOMContentLoaded', function() {
            // Preview de foto
            const fotoInput = document.getElementById('foto');
            fotoInput.addEventListener('change', previewFoto);

            // // Iconos de redes sociales
            // document.getElementById('icon-instagram').addEventListener('click', function() {
            //     toggleSocialInput('instagram');
            // });
            // document.getElementById('icon-facebook').addEventListener('click', function() {
            //     toggleSocialInput('facebook');
            // });
            // document.getElementById('icon-twitter').addEventListener('click', function() {
            //     toggleSocialInput('twitter');
            // });
        });

        // Función para previsualizar la foto
        function previewFoto(event) {
               const file = event.target.files[0];
               const container = document.getElementById('fotoPreviewContainer');

               if (file) {
                   const reader = new FileReader();
                   reader.onload = function(e) {
                       container.innerHTML = `<img src="${e.target.result}" class="foto-preview" alt="Vista previa">`;
                   }
                   reader.readAsDataURL(file);
               }
           }

        // Función para mostrar/ocultar inputs de redes sociales
        function toggleSocialInput(network) {
            const inputContainer = document.getElementById(`input-${network}`);
            const icon = document.getElementById(`icon-${network}`);

            // Toggle del contenedor de input
            inputContainer.classList.toggle('show');

            // Toggle del borde activo en el icono
            icon.classList.toggle('active');

            // Si se oculta, limpiar el input
            if (!inputContainer.classList.contains('show')) {
                const input = document.getElementById(network.charAt(0).toUpperCase() + network.slice(1));
                input.value = '';
            }
        }
    </script>
</body>
</html>